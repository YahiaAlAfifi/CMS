@model List<ContentChangeLogViewModel>

@{
    ViewData["Title"] = "سجل تغييرات الحالة";
    Layout = null;
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>وقت التغيير</th>
            <th>من</th>
            <th>إلى</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ChangeAt</td>
                <td>@item.Old</td>
                <td>@item.New</td>
            </tr>
        }
    </tbody>
</table>
